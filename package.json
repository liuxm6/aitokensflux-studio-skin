{
  "name": "aitokensflux-studio-skin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Ai Tokens Flux client skin for new-api — interactive design prototype",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt src vite.config.ts",
    "format:check": "oxfmt --check src vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-router": "^1.120.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^15.5.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.30.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
